{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dentiva Pro",
  "version": "1.0.0",
  "identifier": "com.dentivapro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost" },
    "windows": [{
      "title": "Dentiva Pro",
      "width": 1440,
      "height": 900,
      "minWidth": 1180,
      "minHeight": 700,
      "center": true,
      "resizable": true,
      "fullscreen": false
    }]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Shohan Khan",
    "copyright": "Copyright © 2026 Shohan Khan",
    "category": "Business",
    "shortDescription": "Offline dental clinic management for Bangladesh",
    "longDescription": "Dentiva Pro is a professional offline-first Windows dental clinic management application.",
    "windows": {
      "nsis": { "installMode": "perMachine", "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
